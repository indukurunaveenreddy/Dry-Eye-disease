{
  "name": "OculoAI Clinical Dry Eye Suite",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bullseye",
  "forwardPorts": [8501],
  "portsAttributes": {
    "8501": {
      "label": "OculoAI Clinical Dry Eye Suite",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "pip install --upgrade pip && pip install -r requirements.txt",
  "postAttachCommand": "streamlit run app.py --server.port=8501 --server.address=0.0.0.0",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ]
    }
  }
}
