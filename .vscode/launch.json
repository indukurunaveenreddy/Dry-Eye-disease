    "version": "0.2.0",
    "configurations": [
        {
            "type": "chrome",
            "request": "launch",
            "name": "Launch Chrome against dashboard",
            "url": "http://localhost:8517",
            "webRoot": "${workspaceFolder}/Dry Eye Disease/dry eye disease"
        },
        {
            "type": "debugpy",
            "request": "launch",
            "name": "Debug Streamlit app",
            "program": "${workspaceFolder}/Dry Eye Disease/dry eye disease/app/app.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/Dry Eye Disease/dry eye disease/src"
            }
        }
    ]
}